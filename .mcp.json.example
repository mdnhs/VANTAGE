{
  "mcpServers": {
    "next-devtools": {
      "command": "npx",
      "args": ["-y", "next-devtools-mcp@latest"]
    },
    "figma-local": {
      "type": "http",
      "url": "http://127.0.0.1:3845/mcp"
    },
    "stitch": {
      "url": "https://stitch.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": "<your Stitch API key — get one from https://stitch.withgoogle.com>"
      }
    }
  }
}
