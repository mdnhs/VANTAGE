# Public app URL (used for canonical links, sitemap, metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Internal API client base — every fetch is built as `${NEXT_PUBLIC_API_PREFIX}${NEXT_PUBLIC_API_VERSION}/...`
NEXT_PUBLIC_API_PREFIX=/api
NEXT_PUBLIC_API_VERSION=/v1

# Set to 'true' to log outgoing API request/response details in dev
DEBUG_API=

# Postgres connection string, e.g. postgresql://user:pass@host:5432/db?sslmode=require
# (drop `?sslmode=require` for a local postgresql://...@localhost/... server).
DATABASE_URL=
# Optional: separate direct connection for drizzle-kit migrations when DATABASE_URL
# goes through a pooler (e.g. PgBouncer in transaction mode). Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=
# Optional: max connections per server instance (default 5).
DB_POOL_MAX=

# Session signing secret — generate with `openssl rand -base64 32`
AUTH_SECRET=

# Better Auth — generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Better Auth base URL. Defaults to NEXT_PUBLIC_APP_URL when unset.
BETTER_AUTH_URL=

# Cloudinary (optional — image uploads are disabled without these)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
