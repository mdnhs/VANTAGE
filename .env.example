# Public app URL (used for canonical links, sitemap, metadata)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Internal API client base — every fetch is built as `${NEXT_PUBLIC_API_PREFIX}${NEXT_PUBLIC_API_VERSION}/...`
NEXT_PUBLIC_API_PREFIX=/api
NEXT_PUBLIC_API_VERSION=/v1

# Set to 'true' to log outgoing API request/response details in dev
DEBUG_API=

# Postgres connection string, e.g. postgresql://user:pass@host:5432/db?sslmode=require
# (drop `?sslmode=require` for a local postgresql://...@localhost/... server).
DATABASE_URL=
# Optional: separate direct connection for drizzle-kit migrations when DATABASE_URL
# goes through a pooler (e.g. PgBouncer in transaction mode). Falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=
# Optional: max connections per server instance (default 5).
DB_POOL_MAX=

# Session signing secret — generate with `openssl rand -base64 32`
AUTH_SECRET=

# Better Auth — generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Better Auth base URL. Defaults to NEXT_PUBLIC_APP_URL when unset.
BETTER_AUTH_URL=

# Cloudinary (optional — image uploads are disabled without these)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Media storage driver: 'local' (default, files under MEDIA_LOCAL_DIR) or 's3' (S3-compatible, e.g. R2)
MEDIA_DRIVER=
# Local driver upload directory (default .uploads)
MEDIA_LOCAL_DIR=
# Public https base URL of the media bucket/CDN; also a Docker build arg (allowed in next/image)
MEDIA_PUBLIC_URL=
# Object key prefix, lowercase letters/digits/hyphens only (default vantage)
MEDIA_KEY_PREFIX=
# S3 driver: Cloudflare account id (used to derive the endpoint)
S3_ACCOUNT_ID=
# S3 driver: explicit endpoint URL (overrides S3_ACCOUNT_ID)
S3_ENDPOINT=
# S3 driver: bucket name (required when MEDIA_DRIVER=s3)
S3_BUCKET=
# S3 driver: access key id (required when MEDIA_DRIVER=s3)
S3_ACCESS_KEY_ID=
# S3 driver: secret access key (required when MEDIA_DRIVER=s3)
S3_SECRET_ACCESS_KEY=

# Key encrypting stored secrets (32 bytes, base64) — generate with `openssl rand -base64 32`
APP_ENCRYPTION_KEY=

# SMTP for outgoing mail
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# 'true' for implicit TLS (port 465)
SMTP_SECURE=
# Default From address, e.g. "Vantage <no-reply@example.com>"
MAIL_FROM=

# 'true' to use the mock AI provider (no external calls)
AI_PROVIDER_MOCK=
# 'true' to disable admin-defined custom scripts
DISABLE_CUSTOM_SCRIPTS=
# 'true' to seed demo users on db seed
SEED_DEMO_USERS=
